{
  "name": "pickleball-randomizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build",
    "test": "node --test tests/*.test.ts",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "next lint",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "cf:typegen": "wrangler types cloudflare-env.d.ts",
    "cf:migrate:local": "wrangler d1 migrations apply pickleball-randomizer --local",
    "cf:migrate:remote": "wrangler d1 migrations apply pickleball-randomizer --remote",
    "dev:next": "next dev",
    "build:next": "next build"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "next": "^16.2.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.9"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@types/node": "20.19.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "typescript": "5.8.3",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  },
  "type": "module"
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickleball-randomizer",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickleball-randomizer",
      "database_id": "e7d30a93-51b3-4a98-926a-e34be823eebc",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULE_ROOMS",
        "class_name": "ScheduleRoom"
      }
    ]
  },
  "exports": {
    "ScheduleRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
